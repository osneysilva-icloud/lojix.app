# =============================================================================
# LOJIX — variáveis de ambiente (copiar para .env.local; NUNCA fazer commit de segredos)
# =============================================================================

# --- Domínio -----------------------------------------------------------------
# Domínio raiz da plataforma (sem protocolo). Lojas ficam em {slug}.NEXT_PUBLIC_ROOT_DOMAIN.
# Desenvolvimento local: localhost:3000  (lojas em http://{slug}.localhost:3000)
NEXT_PUBLIC_ROOT_DOMAIN=lojix.app
# http em desenvolvimento, https em produção
NEXT_PUBLIC_SITE_PROTOCOL=https

# --- Supabase (público: seguro no browser) -----------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Supabase (SEGREDO: só servidor; nunca prefixar com NEXT_PUBLIC_) --------
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Bootstrap do superadmin (SEGREDOS: só ambiente local/alojamento) --------
# Usados apenas por `npm run superadmin:bootstrap`. Não ficam no código nem no Git.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# --- Pagamentos (futuro; ainda sem fornecedor integrado) ---------------------
# Segredo HMAC partilhado para validar webhooks assinados do fornecedor de pagamentos.
# Enquanto estiver vazio, /api/webhooks/payments responde 503.
PAYMENTS_WEBHOOK_SECRET=

# --- Opcional ------------------------------------------------------------------
# Permitir acesso a lojas por caminho /s/{slug} (útil em dev sem DNS wildcard). Desativar em produção.
ALLOW_PATH_STORES=false
